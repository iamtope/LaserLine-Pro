{
  "expo": {
    "name": "Laserline Pro",
    "slug": "laserline-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iamtope.LaserlinePro",
      "deploymentTarget": "16.0",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to provide laser leveling functionality."
      },
      "fonts": [
        "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "package": "com.iamtope.LaserlinePro"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Laserline Pro to access your camera to provide laser leveling functionality."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Laserline Pro to save photos with measurement overlays.",
          "savePhotosPermission": "Allow Laserline Pro to save photos with measurement overlays.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "2fdc820b-4086-4245-8b0e-3567f3eebbfb"
      }
    },
    "owner": "iamtope"
  }
}
